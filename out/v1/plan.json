              "kind": "operation",
              "name": "ListForCustomer",
              "mode": "query",
              "input": [
                {
                  "name": "customerId",
                  "type": {
                    "kind": "prim",
                    "name": "uuid"
                  }
                }
              ],
              "output": {
                "kind": "list",
                "of": {
                  "kind": "ref",
                  "name": "OrderView"
                }
              },
              "errors": []
            }
          ],
          "events": [
