              "input": [
                {
                  "name": "id",
                  "type": {
                    "kind": "prim",
                    "name": "uuid"
                  }
                }
              ],
              "output": {
                "kind": "ref",
                "name": "OrderView"
              },
              "errors": [
                "NotFound"
              ]
            },
