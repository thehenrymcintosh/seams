                "Cancelled"
              ]
            },
            {
              "kind": "record",
              "name": "LineInput",
              "fields": [
                {
                  "name": "productId",
                  "type": {
                    "kind": "prim",
                    "name": "uuid"
                  }
                },
                {
                  "name": "quantity",
                  "type": {
                    "kind": "prim",
                    "name": "int"
                  }
                }
              ]
            },
            {
              "kind": "record",
              "name": "OrderLineView",
