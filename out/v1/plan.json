        {
          "kind": "entity",
          "name": "Order",
          "fields": [
            {
              "name": "id",
              "type": {
                "kind": "prim",
                "name": "uuid"
              }
            },
            {
              "name": "customerId",
              "type": {
                "kind": "prim",
                "name": "uuid"
              }
            },
            {
              "name": "status",
              "type": {
                "kind": "ref",
                "name": "OrderStatus"
              }
            },
            {
              "name": "total",
              "type": {
                "kind": "prim",
                "name": "decimal"
              }
            },
            {
              "name": "placedAt",
              "type": {
                "kind": "prim",
                "name": "datetime"
              }
            }
          ],
          "key": [
            "id"
          ],
          "indexes": []
        },
        {
          "kind": "entity",
          "name": "OrderLine",
          "doc": "Price is copied at order time; Catalog prices may change later.",
          "fields": [
            {
              "name": "id",
              "type": {
                "kind": "prim",
                "name": "uuid"
              }
            },
            {
              "name": "orderId",
              "type": {
                "kind": "prim",
                "name": "uuid"
              }
            },
            {
              "name": "productId",
              "type": {
                "kind": "prim",
                "name": "uuid"
              }
            },
            {
              "name": "quantity",
              "type": {
                "kind": "prim",
                "name": "int"
              }
            },
            {
              "name": "unitPrice",
              "type": {
                "kind": "prim",
                "name": "decimal"
              }
            }
          ],
          "key": [
            "id"
          ],
          "indexes": []
        }
      ],
      "aggregates": [
        {
          "kind": "aggregate",
          "name": "Order",
          "root": "Order",
          "members": [
            "OrderLine"
          ],
          "invariants": [
            "Total equals the sum of its lines.",
            "Lines cannot change once the order is placed."
          ]
        }
      ],
      "repositories": [
        {
          "kind": "repository",
          "name": "OrderRepository",
          "entity": "Order",
          "methods": [
