                  }
                },
                {
                  "name": "quantity",
                  "type": {
                    "kind": "prim",
                    "name": "int"
                  }
                },
                {
                  "name": "unitPrice",
                  "type": {
                    "kind": "prim",
                    "name": "decimal"
                  }
                }
              ]
            },
