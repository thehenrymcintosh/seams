              "kind": "record",
              "name": "OrderView",
              "fields": [
                {
                  "name": "id",
                  "type": {
                    "kind": "prim",
                    "name": "uuid"
                  }
                },
                {
                  "name": "status",
                  "type": {
                    "kind": "ref",
                    "name": "OrderStatus"
                  }
                },
                {
                  "name": "total",
                  "type": {
                    "kind": "prim",
                    "name": "decimal"
                  }
                },
                {
                  "name": "lines",
                  "type": {
                    "kind": "list",
                    "of": {
                      "kind": "ref",
                      "name": "OrderLineView"
                    }
                  }
                }
              ]
            }
